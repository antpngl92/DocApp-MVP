generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationStatus {
  active
  inactive
  suspended
}

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String
  name        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
}

model Organization {
  id              String             @id @default(cuid())
  name            String
  slug            String             @unique
  timezone        String             @default("Europe/Sofia")
  defaultCurrency String             @default("BGN")
  status          OrganizationStatus @default(active)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status])
}

// Starter models — replace with your own
model StarterClinic {
  id        String        @id @default(cuid())
  name      String
  createdAt DateTime      @default(now())
  notes     StarterNote[]
}

model StarterNote {
  id        String        @id @default(cuid())
  clinicId  String
  content   String
  createdAt DateTime      @default(now())
  clinic    StarterClinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}
